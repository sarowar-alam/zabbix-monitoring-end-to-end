# Zabbix Server Configuration Template
# Copy to /etc/zabbix/zabbix_server.conf or use as reference for manual edits.
# Full reference: https://www.zabbix.com/documentation/7.0/en/manual/appendix/config/zabbix_server

# ── Database ──────────────────────────────────────────────────────────────────
DBHost=localhost
DBName=zabbix
DBUser=zabbix
DBPassword=REPLACE_WITH_YOUR_DB_PASSWORD

# ── Network ───────────────────────────────────────────────────────────────────
ListenPort=10051
ListenIP=0.0.0.0

# ── Logging ───────────────────────────────────────────────────────────────────
LogFile=/var/log/zabbix/zabbix_server.log
LogFileSize=10
DebugLevel=3

# ── Performance ───────────────────────────────────────────────────────────────
StartPollers=5
StartTrappers=5
StartPingers=1
StartDiscoverers=1
CacheSize=8M
HistoryCacheSize=16M
TrendCacheSize=4M

# ── PID & Socket ─────────────────────────────────────────────────────────────
PidFile=/run/zabbix/zabbix_server.pid
SocketDir=/run/zabbix
