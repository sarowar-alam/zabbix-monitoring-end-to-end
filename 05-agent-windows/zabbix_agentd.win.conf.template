# Zabbix Agent Configuration Template — Windows
# Managed by: C:\Program Files\Zabbix Agent\zabbix_agentd.conf
# Full reference: https://www.zabbix.com/documentation/7.0/en/manual/appendix/config/zabbix_agentd

# ── Logging ───────────────────────────────────────────────────────────────────
LogFile=C:\ProgramData\Zabbix\zabbix_agentd.log
LogFileSize=10
DebugLevel=3

# ── Server Settings ───────────────────────────────────────────────────────────
# Server: allow-list for passive checks (proxy IP)
Server=REPLACE_WITH_PROXY_PRIVATE_IP

# ServerActive: agent dials OUT to proxy for active checks (no inbound port needed)
ServerActive=REPLACE_WITH_PROXY_PRIVATE_IP

# Hostname: must match EXACTLY the host name in the Zabbix UI
Hostname=windows-agent-01

# ── Include Custom UserParameters ─────────────────────────────────────────────
Include=C:\Program Files\Zabbix Agent\zabbix_agentd.d\*.conf
